# Optional: Supabase cloud sync. The app works without these — it falls
# back to localStorage-only mode (no accounts required) if both are unset.
#
# To enable sync:
#   1. Create a free project at https://supabase.com
#   2. Project Settings → API → copy URL + anon/public key
#   3. Run the SQL in supabase/schema.sql against your project
#   4. Copy this file to .env.local (gitignored) and fill in the values
#   5. Restart the dev server
#
# DO NOT put real values in THIS file (.env.example is committed).
# Real values go in .env.local, which is ignored by .gitignore.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: social sign-in (OAuth). Comma-separated list of providers to show
# on the sign-in page. ONLY list a provider AFTER you've enabled and
# configured it in the Supabase dashboard (Authentication → Providers),
# otherwise its button will error on click. Supported: google, discord.
# Leave blank to offer email magic-link only.
#   e.g. NEXT_PUBLIC_OAUTH_PROVIDERS=google,discord
NEXT_PUBLIC_OAUTH_PROVIDERS=
